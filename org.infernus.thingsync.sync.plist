<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.infernus.thingsync.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jsh/.local/bin/thingsync</string>
        <string>sync</string>
    </array>

    <!-- Run once at login, then exit.  launchd will not restart it. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/tmp/thingsync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/thingsync.log</string>
</dict>
</plist>
